# Discord — control bot (handles slash commands, OAuth)
DISCORD_TOKEN=your_control_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Discord — listener bots (one per shotcaller, joins their voice channel to capture audio)
# Create 3 separate Discord applications. Invite each with bot scope + Connect permission.
LISTENER_BOT_TOKENS=listener_bot_1_token,listener_bot_2_token,listener_bot_3_token
LISTENER_BOT_CLIENT_IDS=listener_bot_1_client_id,listener_bot_2_client_id,listener_bot_3_client_id

# Discord — speaker bots (one per team channel, plays audio there)
# Create 3 separate Discord applications. Invite each with bot scope + Connect + Speak permissions.
SPEAKER_BOT_TOKENS=speaker_bot_1_token,speaker_bot_2_token,speaker_bot_3_token
SPEAKER_BOT_CLIENT_IDS=speaker_bot_1_client_id,speaker_bot_2_client_id,speaker_bot_3_client_id

# API
API_PORT=3001
API_SECRET=change_this_to_a_random_secret
DATABASE_PATH=./data/relay.db
BOT_INVITE_PERMISSIONS=36701184

# Web
VITE_API_URL=http://localhost:3001
VITE_DISCORD_CLIENT_ID=your_client_id_here
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
